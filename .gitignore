# 构建产物、界面截图和本机验证资料
bin/
obj/
artifacts/
staging/

# 前端依赖、编译缓存和自动验证产物
# 保留 package.json、package-lock.json、配置、测试源码及第三方许可说明
node_modules/
/frontend/dist/
/frontend/dist-desktop/
/frontend/output/
.playwright-cli/
*.tsbuildinfo
/frontend/.vite/
/frontend/coverage/
/frontend/test-results/
/frontend/playwright-report/
/frontend/src-tauri/target/
/frontend/src-tauri/gen/schemas/

# 每版待上传的 Release 附件；保留根目录说明
/releases/*/

# 本地工具和编辑器状态
/.codex/
.vs/
*.user
*.suo

# 编译文件和本机驱动组件（不分发 Dolby DLL）
*.exe
*.exe.config
*.dll
*.pdb
# 构建必需的 SVCL 原始程序；同目录许可和帮助文件也保留
!/vendor/svcl/svcl.exe
# 已解压到 vendor/svcl/，构建不使用此重复下载包
/vendor/svcl-x64.zip

# 个人音频设置、导出文件及自动备份
settings.json
AudioSwitch-settings-*.json
backups/
# 程序被复制到其他项目子目录运行时，也不上传更新／修复前的本机备份
update-backups/
repair-backups/

# 日志、崩溃转储及临时文件
*.log
*.dmp
*.tmp
*.bak
*~
Thumbs.db
Desktop.ini

# 本地凭据文件；保留可公开的环境变量示例
.env
.env.*
!.env.example
!.env.sample
*.pfx
*.p12
*.key

# AGENTS.md、CODE_REVIEW.md、MANUAL-TESTS.md、frontend/VALIDATION.md
# 是共享的协作／验证文档，保留在仓库中；个人工具状态由上方规则排除。
